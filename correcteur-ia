#!/usr/bin/env python3
import json
import subprocess
import time
import urllib.request

MODEL = "llama3:latest"
URL = "http://localhost:11434/api/generate"

def notify(message):
    subprocess.run(["notify-send", "Correcteur IA", message], check=False)

def main():
    # Copy the selected text from the active application.
    subprocess.run(["ydotool", "key", "ctrl+c"], check=True)
    time.sleep(0.4)

    original = subprocess.run(
        ["wl-paste", "--no-newline"],
        capture_output=True, text=True, check=True
    ).stdout

    if not original.strip():
        notify("Aucun texte sélectionné. Rien n'a été remplacé.")
        return

    prompt = (
    "You are a context-aware text correction assistant. "
    "Rewrite the input into correct, natural language while preserving "
    "the user's intended meaning, tone, and level of formality and rewrite it in the same language of the input. "
    "Fix spelling mistakes, typos, grammar, punctuation, missing words, "
    "incorrect word forms, and malformed or incomplete sentences. "
    "Infer the most likely intended wording when the input contains "
    "obvious mistakes, even if several words need to be corrected. "
    "For example, 'i stupiiid' should become 'I'm stupid.' "
    "Do not limit yourself to correcting individual spelling mistakes. "
    "Do not add new ideas or unnecessary details. "
    "Do not explain your corrections or include notes, labels, or quotes. "
    "Return only the corrected text. "
    "Do not change the language if the inpput text in french return it corrected in french"
    "If the input is already correct, leave it unchanged.\n\n"
    + original
    )
    payload = json.dumps({
        "model": MODEL,
        "prompt": prompt,
        "stream": False,
        "keep_alive": "24h"
    }).encode("utf-8")

    request = urllib.request.Request(
        URL, data=payload,
        headers={"Content-Type": "application/json"}
    )

    with urllib.request.urlopen(request, timeout=180) as response:
        corrected = json.load(response)["response"].strip()

    if not corrected:
        notify("Aucune correction reçue. Rien n'a été remplacé.")
        return

    subprocess.run(
        ["wl-copy"], input=corrected, text=True, check=True
    )
    time.sleep(0.2)
    subprocess.run(["ydotool", "key", "ctrl+v"], check=True)
    notify("Texte corrigé.")

if __name__ == "__main__":
    try:
        main()
    except Exception as exc:
        notify(f"Erreur : {exc}")
